# ---- LLM for TradingAgents (set the one you use) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional: choose provider/models without editing config.yaml
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
# TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5

# ---- Vibe-Trading second opinion (read by its own process) ----
# LANGCHAIN_PROVIDER=anthropic
# LANGCHAIN_MODEL_NAME=claude-sonnet-5

# ---- Broker (only for live trading) ----
# INDTRADER_BROKER=paper            # paper | zerodha | openalgo
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=                  # or run `indtrader zerodha-login` each morning
KITE_ALGO_ID=                       # exchange-assigned algo id, if your broker requires one
OPENALGO_API_KEY=

# ---- Alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
